# Defaults: fully local UI demo; never silently switches between modes.
VITE_GAME_MODE=mock
VITE_AUTH_MODE=demo

# Set GAME_MODE=live to connect the existing Node Socket.IO server.
VITE_BACKEND_URL=http://localhost:3001

# Set AUTH_MODE=live when the REST backend is implemented.
# API base without /api. Empty = same origin. No secrets in VITE_* variables.
VITE_API_URL=http://localhost:8000
